# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPPORT_EMAIL=hello@onebook.app

# MongoDB Atlas (replace USER, PASSWORD, CLUSTER, DB)
DATABASE_URL="mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/facbook?retryWrites=true&w=majority&appName=Cluster0"

# Required. 16+ random characters. Used to sign HTTP-only session cookies.
AUTH_SECRET="change-me-to-a-long-random-secret"

# Optional seed password for owner mursalin@facbook.app
SEED_OWNER_PASSWORD="Facbook@123"

# Telegram alerts (set in Vercel dashboard — never commit real tokens)
# 1) Create bot via @BotFather, put token in TELEGRAM_BOT_TOKEN
# 2) Message the bot /start, open /api/telegram as owner to get chat id
# 3) Set TELEGRAM_CHAT_ID, redeploy
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
